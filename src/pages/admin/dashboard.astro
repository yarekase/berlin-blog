---
/**
 * 後台儀表板主頁面
 * 這是經過重構的主頁面，使用了模塊化組件
 */
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Statistics from "../../components/Statistics.astro";
import PostsList from "../../components/PostsList.astro";
import EditModal from "../../components/EditModal.astro";
import SettingsModal from "../../components/SettingsModal.astro";
import "../../styles/editor.css";
import { postManager, type Post } from "../../utils/postManager";
import { env } from 'cloudflare:workers';

// 伺服器端抓取資料
const  DB  = (env as any).DB || {};
let posts: Post[] = [];

if (DB) {
  try {
    posts = await postManager.getPosts(DB);
    console.log("伺服器端獲取文章成功:", posts);
  } catch (error) {
    console.error("伺服器端獲取文章失敗:", error);
  }
} else {
  console.warn("伺服器端未找到 'DB' 綁定，無法獲取文章資料。");
}
---

<Layout title="後台儀表板 - 子迂的蠹酸齋">
  <main class="min-h-screen bg-void-black text-stucco-white font-display pb-24">
    <!-- 導航欄 -->
    <Navigation />

    <!-- 主要內容 -->
    <div class="max-w-350 mx-auto px-6 py-8">
      <!-- 儀表板統計 -->
      <Statistics />

      <!-- 文章管理區 -->
      <PostsList posts={posts} />
    </div>
  </main>

  <!-- 編輯模態框 -->
  <EditModal />

  <!-- 設定模態框 -->
  <SettingsModal />
</Layout>

<script>
  // 將邏輯抽離到外部檔案，保持 Astro 檔案簡潔
  import { initDashboard } from "../../scripts/adminDashboard";
  
  document.addEventListener("DOMContentLoaded", () => {
    initDashboard();
  });
</script>
