---
/**
 * 後台儀表板主頁面
 * 這是經過重構的主頁面，使用了模塊化組件
 */
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Statistics from "../../components/Statistics.astro";
import PostsList from "../../components/PostsList.astro";
import EditModal from "../../components/EditModal.astro";
import SettingsModal from "../../components/SettingsModal.astro";
import "../../styles/editor.css";
import { postManager, type Post } from "../../utils/postManager";
import { env } from 'cloudflare:workers';

// 伺服器端抓取資料
const  DB  = (env as any).DB || {};
let posts: Post[] = [];

if (DB) {
  try {
    posts = await postManager.getPosts(DB);
    console.log("伺服器端獲取文章成功:", posts);
  } catch (error) {
    console.error("伺服器端獲取文章失敗:", error);
  }
} else {
  console.warn("伺服器端未找到 'DB' 綁定，無法獲取文章資料。");
}
---

<Layout title="後台儀表板 - 子迂的蠹酸齋">
  <main class="min-h-screen bg-void-black text-stucco-white font-display pb-24">
    <!-- 導航欄 -->
    <Navigation />

    <!-- 主要內容 -->
    <div class="max-w-350 mx-auto px-6 py-8">
      <!-- 儀表板統計 -->
      <Statistics />

      <!-- 文章管理區 -->
      <PostsList posts={posts} />
    </div>
  </main>

  <!-- 編輯模態框 -->
  <EditModal />

  <!-- 設定模態框 -->
  <SettingsModal />
</Layout>

<script>
  import axios from "axios";
  import {
    checkAuth,
    logout,
    setNickname,
    getNickname,
  } from "../../utils/auth";
  import {
    postManager,
    type Post,
    type Category,
  } from "../../utils/postManager";
  import {
    initEditor,
    saveEditorContent,
    destroyEditor,
  } from "../../utils/editorManager";

  /**
   * 斷言輔助函數：取得 DOM 元素並保證其存在
   * 如果找不到元素，它會直接拋出錯誤。
   * 這樣後續代碼就不用處理 null 問題。
   */
  function $<T>(id: string, required = true): T {
    const el = document.getElementById(id);
    if (!el && required) {
      throw new Error(`必要的 DOM 元素 #${id} 缺失，請檢查組件結構。`);
    }
    return el as unknown as T;
  }

  // ===== 全局變數 - 外層作用域 =====
  let editModal: HTMLDivElement;
  let settingsModal: HTMLDivElement;

  // ===== 渲染函數 =====
  function renderPosts() {
    // const postsList = document.getElementById(
    //   "postsList",
    // ) as HTMLTableSectionElement | null;
    // const publishedCount = document.getElementById(
    //   "publishedCount",
    // ) as HTMLDivElement | null;
    // const draftCount = document.getElementById(
    //   "draftCount",
    // ) as HTMLDivElement | null;
    // const totalCount = document.getElementById(
    //   "totalCount",
    // ) as HTMLDivElement | null;

    // if (!postsList) return;

    // const posts = postManager.getPosts();

    // if (posts.length === 0) {
    //   postsList.innerHTML =
    //     '<tr><td colspan="6" class="px-6 py-8 text-center text-slate-500">暫無文章</td></tr>';
    // } else {
    //   postsList.innerHTML = posts
    //     .map(
    //       (post) => `
    //     <tr class="border-t border-white/10 hover:bg-void-black/50 transition-colors">
    //       <td class="px-6 py-4 text-white">${post.title}</td>
    //       <td class="px-6 py-4 text-slate-400 text-sm">${post.author_name}</td>
    //       <td class="px-6 py-4 text-slate-400 text-sm">${post.categories.map((c) => c.name).join(", ")}</td>
    //       <td class="px-6 py-4">
    //         <span class="px-3 py-1 text-xs font-medium rounded ${
    //           post.status === "published"
    //             ? "bg-green-500/20 text-green-400"
    //             : "bg-yellow-500/20 text-yellow-400"
    //         }">
    //           ${post.status === "published" ? "發佈" : "草稿"}
    //         </span>
    //       </td>
    //       <td class="px-6 py-4 text-slate-400 text-sm">${new Date(post.created_at).toLocaleDateString()}</td>
    //       <td class="px-6 py-4 text-sm">
    //         <button class="text-primary hover:text-primary/80 transition-colors mr-4" onclick="editPost('${post.id}')">編輯</button>
    //         <button class="text-red-500 hover:text-red-400 transition-colors" onclick="deletePost('${post.id}')">刪除</button>
    //       </td>
    //     </tr>
    //   `,
    //     )
    //     .join("");
    window.location.reload(); // 簡化處理，直接刷新頁面重新渲染
  }

  async function editPost(id: string) {
    const token = localStorage.getItem("adminToken");
    if (!token) {
      alert("未登入或登入已過期，請重新登入。");
      checkAuth(); // 假設 checkAuth 會處理重定向
      return;
    }

    let post: Post;
    let categories: Category[];

    try {
      // 1. 使用 axios 獲取文章資料 (自動處理 json)
      const postRes = await axios.get<Post>(`/admin/posts/${id}`);
      post = postRes.data;

      // 2. 使用 axios 獲取分類清單
      const catRes = await axios.get<Category[]>("/categories");
      categories = catRes.data;

      // 【修正】在函式內部宣告並取得必要的 DOM 元素
      const titleInput = $<HTMLInputElement>("title");
    const authorNameInput = $<HTMLInputElement>("author_name");
    const slugInput = $<HTMLInputElement>("slug");
    const summaryTextarea = $<HTMLTextAreaElement>("summary");
    const coverImageInput = $<HTMLInputElement>("cover_image");
    const statusSelect = $<HTMLSelectElement>("status");
    const modalTitle = $<HTMLHeadingElement>("modalTitle");
    const submitBtn = $<HTMLButtonElement>("submitBtn");
    const postForm = $<HTMLFormElement>("postForm");
    const categoriesContainer = $<HTMLDivElement>("categoriesContainer");

    // 填充表單
    titleInput.value = post.title;
    authorNameInput.value = post.author_name;
    slugInput.value = post.slug;
    summaryTextarea.value = post.summary || "";
    coverImageInput.value = post.cover_image;
    statusSelect.value = post.status;

    // 生成分類選項
    categoriesContainer.innerHTML = categories
      .map(
        (category) => `
        <label class="flex items-center">
          <input
            type="checkbox"
            value="${category.id}"
            class="mr-2"
            ${post.categories.some((c) => c.id === category.id) ? "checked" : ""}
          />
          ${category.name}
        </label>
      `,
      )
      .join("");

    // 初始化 Editor.js 並載入內容
    const editorData = post.content ? JSON.parse(post.content) : null;
    await initEditor(editorData);

    modalTitle.textContent = "編輯文章";
    submitBtn.textContent = "更新";

      postForm.onsubmit = async (e: Event) => {
        e.preventDefault();
        const contentData = await saveEditorContent();

        // 獲取選中的分類
        const selectedCategoryIds = Array.from(
          categoriesContainer.querySelectorAll('input[type="checkbox"]:checked'),
        ).map((checkbox) => parseInt((checkbox as HTMLInputElement).value));
        const selectedCategories = categories.filter((c) =>
          selectedCategoryIds.includes(c.id),
        );

        try { // 針對 PUT 請求的 try-catch
          await axios.put("/admin/posts", {
            id,
            updates: {
              title: titleInput.value,
              author_name: authorNameInput.value,
              content: JSON.stringify(contentData),
              summary: summaryTextarea.value || undefined,
              cover_image: coverImageInput.value,
              status: statusSelect.value as "draft" | "published",
              categories: selectedCategories,
            },
          }, {
            headers: {
              Authorization: `Bearer ${token}`,
            },
          });

          renderPosts();
          await destroyEditor();
          editModal.classList.add("hidden");
        } catch (error: any) {
          const errMsg = error.response?.data?.error || "更新文章失敗";
          alert(errMsg);
        }
      };

      editModal.classList.remove("hidden");
    } catch (error: any) {
      const errMsg = error.response?.data?.error || "載入編輯文章資料失敗";
      alert(errMsg);
    }
  }

  async function deletePost(id: string) {
    if (!confirm("確定要刪除這篇文章嗎？此操作無法復原。")) return;

    const token = localStorage.getItem("adminToken");
    if (!token) {
      alert("未登入或登入已過期，請重新登入。");
      checkAuth();
      return;
    }
    try {
      // 調用 Hono API 的 DELETE 方法
      await axios.delete(`/admin/posts`, {
        params: { id },
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      renderPosts();
    } catch (error: any) {
      const errMsg = error.response?.data?.error || "刪除失敗";
      alert(errMsg);
    }
  }

  // ===== 頁面初始化 - DOMContentLoaded =====
  document.addEventListener("DOMContentLoaded", () => {
    // 認證檢查
    checkAuth();

    // 取得模態框和按鈕元素
    editModal = $<HTMLDivElement>("editModal", true);
    settingsModal = $<HTMLDivElement>("settingsModal", true);

    // 這些按鈕可能在不同的組件中，建議先檢查是否存在
    const newPostBtn = document.getElementById("newPostBtn");
    const settingsBtn = document.getElementById("settingsBtn");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const closeSettingsBtn = document.getElementById("closeSettingsBtn");
    const logoutBtn = document.getElementById("logoutBtn");
    const settingsForm = document.getElementById(
      "settingsForm",
    ) as HTMLFormElement;
    const postForm = document.getElementById("postForm") as HTMLFormElement;

    // ===== 事件委派 - 處理表格按鈕點擊 =====
    // 透過監聽 tbody 確保動態生成的按鈕也能正常運作
    const postsListContainer = document.getElementById("postsList");
    if (postsListContainer) {
      postsListContainer.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const id = target.getAttribute("data-id");
        if (!id) return;

        if (target.classList.contains("edit-btn")) {
          editPost(id);
        } else if (target.classList.contains("delete-btn")) {
          deletePost(id);
        }
      });
    }

    // ===== 新增文章按鈕邏輯 =====
    newPostBtn?.addEventListener("click", async () => {
      // 先打開模態框，讓使用者感覺有反應
      editModal.classList.remove("hidden");

      const modalTitle = $<HTMLHeadingElement>("modalTitle");
      const submitBtn = $<HTMLButtonElement>("submitBtn");
      const categoriesContainer = $<HTMLDivElement>("categoriesContainer");

      if (postForm) {
        postForm.reset();
        modalTitle.textContent = "新增文章";
        submitBtn.textContent = "新增";

        // 注入預設作者
        const authorInput = $<HTMLInputElement>("author_name");
        authorInput.value = getNickname();

        // 異步加載分類
        let categories: Category[] = [];
        try { // 針對獲取分類的 try-catch
          // 修正路徑：從 /categories 改為 /admin/posts/categories
          const catRes = await axios.get<Category[]>("/categories");
          categories = catRes.data;
          
          categoriesContainer.innerHTML = categories
            .map(
              (category) => `
              <label class="flex items-center">
                <input type="checkbox" value="${category.id}" class="mr-2" />
                ${category.name}
              </label>
            `,
            )
            .join("");
        } catch (error) {
          console.error("獲取分類列表失敗:", error);
          alert("獲取分類列表失敗，請檢查網路連線或伺服器狀態。");
          // editModal.classList.add("hidden"); // 如果分類載入失敗，隱藏模態框
          return;
        }

        initEditor();
        postForm.onsubmit = async (e: Event) => {
          e.preventDefault();
          const token = localStorage.getItem("adminToken");
          const contentData = await saveEditorContent();

          // 使用 $ 函數，如果元素不存在會直接中斷執行
          const titleInput = $<HTMLInputElement>("title");
          const authorNameInput = $<HTMLInputElement>("author_name");
          const slugInput = $<HTMLInputElement>("slug");
          const summaryTextarea = $<HTMLTextAreaElement>("summary");
          const coverImageInput = $<HTMLInputElement>("cover_image");
          const statusSelect = $<HTMLSelectElement>("status");
          const categoriesContainer = $<HTMLDivElement>("categoriesContainer");

          // 獲取選中的分類
          const selectedCategoryIds = Array.from(
            categoriesContainer.querySelectorAll(
              'input[type="checkbox"]:checked',
            ),
          ).map((checkbox) => parseInt((checkbox as HTMLInputElement).value));
          const selectedCategories = categories.filter((c) =>
            selectedCategoryIds.includes(c.id),
          );
          
          try { // 針對 POST 請求的 try-catch
            await axios.post("/admin/posts", {
              title: titleInput.value,
              author_name: authorNameInput.value,
              content: JSON.stringify(contentData),
              cover_image: coverImageInput.value,
              status: statusSelect.value as "draft" | "published",
              categories: selectedCategories,
            }, {
              headers: {
                Authorization: `Bearer ${token}`,
              },
            });

            renderPosts();
            await destroyEditor();
            editModal.classList.add("hidden");
          } catch (error: any) {
            const errMsg = error.response?.data?.error || "新增文章失敗";
            alert(errMsg);
          }

          }
        };
      } // <--- 補上這個括號，關閉 if 區塊
    );

    // ===== 設定按鈕 =====
    settingsBtn?.addEventListener("click", () => {
      const nicknameInput = $<HTMLInputElement>("nickname");
      nicknameInput.value = getNickname();
      settingsModal.classList.remove("hidden"); // settingsModal 已經保證存在
    });

    // ===== 關閉模態框 =====
    closeModalBtn?.addEventListener("click", () => {
      editModal.classList.add("hidden");
      destroyEditor();
    });

    closeSettingsBtn?.addEventListener("click", () => {
      settingsModal.classList.add("hidden");
    });

    // 點擊背景關閉模態框 (editModal 和 settingsModal 已經保證存在)
    editModal.addEventListener("click", (e: Event) => {
      if (e.target === editModal) editModal.classList.add("hidden");
      destroyEditor(); // 確保編輯器被銷毀
    });
    settingsModal.addEventListener("click", (e: Event) => {
      if (e.target === settingsModal) settingsModal.classList.add("hidden");
    });

    // ===== Slug 自動生成 =====
    try {
      const titleInput = $<HTMLInputElement>("title");
      const slugInput = $<HTMLInputElement>("slug");
      titleInput.addEventListener("input", () => {
        const slug = titleInput.value
          .toLowerCase()
          .replace(/[^\w\s-]/g, "")
          .replace(/[\s_-]+/g, "-")
          .replace(/^-+|-+$/g, "");
        slugInput.value = slug;
      });
    } catch (e) {}

    // ===== 設定表單提交 (settingsForm 已經保證存在) =====
    settingsForm?.addEventListener("submit", (e: Event) => {
      e.preventDefault();
      const nicknameInput = $<HTMLInputElement>("nickname");
      setNickname(nicknameInput.value);
      settingsModal.classList.add("hidden");
      alert("設定已保存");
    });

    // ===== 登出 =====
    logoutBtn?.addEventListener("click", () => logout());

    // 初始化頁面：
    // 這裡不需要呼叫 renderPosts()，因為 Astro 已經在伺服器端渲染好文章列表了。
    // 呼叫它會導致無限重新整理迴圈。
  });
</script>
