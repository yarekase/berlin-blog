---
/**
 * 編輯/新增文章模態框組件
 * 包含表單表格和 Editor.js 編輯器
 */
---

<!-- 模態框最外層容器：控制顯示/隱藏、背景遮罩和居中佈局 -->
<div
  id="editModal"
  class="hidden fixed inset-0 bg-black/50 z-50 items-center justify-center p-4 backdrop-blur-sm"
>
  <div
    class="bg-void-black border border-white/10 rounded-lg max-w-300 w-full max-h-[95vh] overflow-y-auto"
  >
    <!-- 模態框頭部：包含標題和關閉按鈕 -->
    <div
      class="sticky top-0 bg-void-black border-b border-white/10 px-6 py-4 flex items-center justify-between"
    >
      <h3 class="text-xl font-bold" id="modalTitle"></h3>
      <button
        id="closeModalBtn"
        class="text-slate-400 hover:text-white transition-colors"
      >
        ✕
      </button>
    </div>

    <!-- 表單區塊：用於提交文章數據 -->
    <form id="postForm" class="p-6 space-y-6">
      <div>
        <!-- 文章標題輸入框 -->
        <label for="title" class="block text-sm font-medium text-slate-400 mb-2"
          >文章標題</label
        >
        <input
          type="text"
          id="title"
          name="title"
          class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          required
        />
      </div>

      <div>
        <!-- 作者名稱輸入框 -->
        <label
          for="author_name"
          class="block text-sm font-medium text-slate-400 mb-2">作者名稱</label
        >
        <input
          type="text"
          id="author_name"
          name="author_name"
          class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          required
        />
      </div>

      <div>
        <!-- 分類選擇區塊：選項將通過 JavaScript 動態生成 -->
        <span
          class="block text-sm font-medium text-slate-400 mb-2"
          >分類 (可多選)</span
        >
        <div class="mb-4 flex items-center space-x-2">
          <input type="text" id="newCategoryInput" 
            placeholder="輸入新分類名稱" 
            class="flex-1 rounded border-white/20 bg-void-black text-sm text-white focus:ring-primary">
          <button type="button" id="addCategoryBtn" 
                  class="rounded bg-primary px-3 py-1 text-sm text-white hover:bg-primary-dark">
            新增分類
          </button>
        </div>

        <div id="categoriesContainer" class="space-y-2">
          <!-- 動態生成分類選項 -->
        </div>
      </div>

      <div>
        <!-- 摘要 (SEO 用) 文字區域 -->
        <label
          for="summary"
          class="block text-sm font-medium text-slate-400 mb-2"
          >摘要 (SEO 用)</label
        >
        <textarea
          id="summary"
          name="summary"
          rows="3"
          class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          placeholder="可留空，系統會自動從內容生成"></textarea>
      </div>

      <div class="space-y-2">
        <!-- 封面圖上傳區塊 -->
        <label class="block text-sm font-medium text-slate-400">封面圖上傳</label>
  
        <div class="relative border-2 border-dashed border-white/20 rounded-lg p-4 hover:border-primary transition-colors group cursor-pointer">
          <input 
          type="file"
          id="cover_upload"
          name="cover_upload"
          class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" 
          accept="image/jpeg, image/png, image/webp, image/heic, image/heif" />
    
          <div class="text-center">
            <p class="text-slate-400 group-hover:text-white transition-colors">點擊或拖拽圖片至此</p>
            <p class="text-xs text-slate-500">支援 HEIC, HEIF, JPG, PNG, WebP</p>
          </div>
        </div>
  
        <div id="preview_container" class="mt-4 hidden">
          <img id="image_preview" src="#" class="w-full h-48 object-cover rounded border border-white/20" />
        </div>
      </div>

      <div>
        <!-- 內容編輯器區塊：用於初始化 Editor.js -->
        <span
          class="block text-sm font-medium text-slate-400 mb-2">內容</span>
        <div
          id="editorjs"
          class="min-h-100 border border-white/20 rounded p-4 bg-void-black text-white"
        >
        </div>
        <textarea id="content" name="content" class="hidden"></textarea>
      </div>

      <!-- 狀態和發佈日期選擇區塊 -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <!-- 狀態選擇下拉菜單 -->
          <label
            for="status"
            class="block text-sm font-medium text-slate-400 mb-2">狀態</label
          >
          <select
            id="status"
            name="status"
            class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          >
            <option value="draft">草稿</option>
            <option value="published">發佈</option>
          </select>
        </div>
        <div>
          <!-- 發佈日期時間選擇器 -->
          <label
            for="publishedAt"
            class="block text-sm font-medium text-slate-400 mb-2"
            >發佈日期</label
          >
          <input
            type="datetime-local"
            id="publishedAt"
            name="publishedAt"
            class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          />
        </div>
      </div>

      <!-- 表單操作按鈕區塊：保存和取消 -->
      <div class="flex gap-4 pt-4">
        <button
          type="submit"
          id="submitBtn"
          class="flex-1 bg-primary text-white px-6 py-2 rounded font-bold hover:bg-primary/80 transition-all"
        >
          保存
        </button>
        <button
          type="button"
          id="cancelModalBtn"
          class="flex-1 bg-void-black border border-white/20 text-white px-6 py-2 rounded font-bold hover:border-white/40 transition-all"
        >
          取消
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  /**
   * 【高內聚邏輯封裝】
   * 此腳本負責處理 EditModal 的所有生命週期：從開啟、編輯器初始化、資料抓取到表單提交。
   * 這樣 dashboard.astro 就不需要知道編輯器是如何運作的。
   */
  import { authManager } from "../utils/auth";
  import { type Post, type Category } from "../utils/postManager";
  import { initEditor, saveEditorContent, destroyEditor } from "../utils/editorManager";
  import "../styles/editor.css"; // 確保編輯器樣式被加載
  import api from "../utils/api"; // 使用封裝好的 API 實例

  const getNickname = () => authManager.getNickname();
  const nickname = getNickname();
 

  // 內部 DOM 選取輔助函數
  const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

  const modal = $("editModal");
  const form = $<HTMLFormElement>("postForm");
  const categoriesContainer = $("categoriesContainer");
  const modalTitle = $("modalTitle");
  const submitBtn = $<HTMLButtonElement>("submitBtn");
  const newCatInput = $<HTMLInputElement>("newCategoryInput");
  const addCatBtn = $("addCategoryBtn");

  let currentPostId: string | null = null; // 紀錄目前是否處於「編輯模式」
  let allCategories: Category[] = [];    // 快取分類清單

  /**
   * 渲染分類核取方塊
   */
  function renderCategories(selectedIds: number[]) {
    categoriesContainer.innerHTML = allCategories.map(cat => `
      <label class="flex items-center space-x-2 text-sm text-slate-300">
        <input type="checkbox" value="${cat.id}" ${selectedIds.includes(cat.id) ? "checked" : ""} 
               class="rounded border-white/20 bg-void-black text-primary focus:ring-primary">
        <span>${cat.name}</span>
      </label>
    `).join("");
  }

  // --- 1. 初始化與開啟邏輯 ---

  /**
   * 開啟模態框的統一入口
   * @param id 如果有 id 則進入「編輯模式」，否則為「新增模式」
   */
  async function openModal(id: string | null = null) {
    currentPostId = id;
    form.reset();
    
    try {
      // 每次開啟都確認分類清單（確保資料最新）
      try {
        // baseURL 已經是 /admin/posts，所以這裡只需寫 /categories
        const { data } = await api.get<Category[]>("/categories");
        allCategories = data;
      }catch(err){
        console.error("API 抓取失敗，分類歸0", err);
        allCategories = [];
      }

      if (id) {
        // 【編輯模式】
        modalTitle.textContent = "編輯文章";
        submitBtn.textContent = "更新文章";
        
        // 抓取該篇文章的詳細內容
        const { data: post } = await api.get<Post>(`/${id}`);
        
        // 填充表單欄位
        ($("title") as HTMLInputElement).value = post.title;
        ($("author_name") as HTMLInputElement).value = post.author_name;
        ($("summary") as HTMLTextAreaElement).value = post.summary || "";
        (($("status") as unknown) as HTMLSelectElement).value = post.status;
        
        renderCategories(post.categories.map(c => c.id));
        
        // 初始化編輯器並載入 JSON 內容
        await initEditor(post.content ? JSON.parse(post.content) : null);
      } else {
        // 【新增模式】
        modalTitle.textContent = "新增文章";
        submitBtn.textContent = "發布文章";
        
        // 預設填入當前暱稱
        ($("author_name") as HTMLInputElement).value = nickname || "";
        
        renderCategories([]);
        
        // 稍微延遲初始化編輯器，確保 DOM 已完全顯示以避免 Editor.js 渲染錯誤
        setTimeout(() => initEditor(), 50);
      }

      // 顯示模態框
      modal.classList.replace("hidden", "flex");
    } catch (err) {
      alert("無法載入資料，請檢查網路狀態");
      console.error(err);
    }
  }

  function closeModal() {
    modal.classList.replace("flex", "hidden");
    destroyEditor(); // 關閉時必須銷毀實例，釋放記憶體並避免下次開啟衝突
    currentPostId = null;
  }



  // --- 2. 事件監聽 ---

  /**
   * 使用自定義事件 (Custom Event) 實現「低耦合」
   * 外部腳本 (adminDashboard.ts) 只需要發送這個事件，不需要 import 本組件的 function
   */
  window.addEventListener("open-edit-modal", (e: any) => {
    openModal(e.detail?.id);
  });

  $("closeModalBtn").onclick = closeModal;
  $("cancelModalBtn").onclick = closeModal;

  // // 點擊半透明背景時關閉
  // modal.onclick = (e) => { if (e.target === modal) closeModal(); };

  // --- 3. 提交邏輯 ---

  form.onsubmit = async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    const originalBtnText = submitBtn.textContent;
    submitBtn.textContent = "儲存中...";
    
    
    // 1. 取得編輯器 JSON 資料
    const contentData = await saveEditorContent();
    
    // 2. 取得選中的分類 ID
    const selectedCatIds = Array.from(categoriesContainer.querySelectorAll('input:checked'))
      .map(i => parseInt((i as HTMLInputElement).value));

    // 3. 準備提交內容
    const payload = {
      title: ($("title") as HTMLInputElement).value,
      author_name: ($("author_name") as HTMLInputElement).value,
      content: JSON.stringify(contentData),
      summary: ($("summary") as HTMLTextAreaElement).value,
      status: (($("status")as unknown) as HTMLSelectElement).value,
      categories: allCategories.filter(c => selectedCatIds.includes(c.id)),
      cover_image: coverImageUrl
    };



    try {
      if (currentPostId) {
        // 更新現有文章
        await api.put("/", { id: currentPostId, updates: payload });
      } else {
        // 新增文章
        await api.post("/", payload);
      }
      
      
      // 操作成功後刷新頁面（這是最簡單的資料同步方式）
      window.location.reload();
    } catch (error: any) {
      alert(error.response?.data?.error || "保存失敗，請檢查權限");
    }
  };


  // 新增分類按鈕監聽器
  addCatBtn.addEventListener("click", async () => {
  const name = newCatInput.value.trim();
  if (!name) return alert("請輸入分類名稱");

  // 1. 前端初步檢查：是否已經存在於目前的 allCategories 陣列中
  const isDuplicate = allCategories.some(
    cat => cat.name === name || cat.slug === name.toLowerCase()
  );
  
  if (isDuplicate) {
    return alert("這個分類已經存在囉！");
  }

  try {
    // 2. 正式發送 API 到後端
    const { data: newCategory } = await api.post<Category>("/categories", { name });

    // 3. 成功後，更新前端的資料源 (這時 newCategory 包含真正的資料庫 ID)
    allCategories.push(newCategory);

    // 4. 取得目前已經勾選的 ID 陣列
    const currentSelected = Array.from(
      categoriesContainer.querySelectorAll('input[type="checkbox"]:checked')
    ).map(el => Number((el as HTMLInputElement).value));

    // 5. 將新分類的 ID 加入勾選清單
    currentSelected.push(newCategory.id);

    // 6. 重新渲染清單
    renderCategories(currentSelected);

    // 7. 清空輸入框
    newCatInput.value = "";
    
  } catch (err: any) {
    // 處理 API 回傳的重複報錯 (409) 或其他錯誤
    if (err.response && err.response.status === 409) {
      alert("新增失敗：分類名稱或 Slug 已被佔用");
    } else {
      alert("伺服器連線失敗，請稍後再試");
    }
    console.error(err);
  }
});

  
</script>
