---
import CategorySection from './CategorySection.astro';
import CoverSection from './CoverSection.astro';
---

<div id="editModal" class="hidden fixed inset-0 bg-black/50 z-50 items-center justify-center p-4 backdrop-blur-sm">
  <div class="bg-void-black border border-white/10 rounded-lg max-w-300 w-full max-h-[95vh] overflow-y-auto">
    <div class="sticky top-0 bg-void-black border-b border-white/10 px-6 py-4 flex items-center justify-between">
      <h3 class="text-xl font-bold" id="modalTitle"></h3>
      <button id="closeModalBtn" class="text-slate-400 hover:text-white">✕</button>
    </div>

    <form id="postForm" class="p-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="title" class="block text-sm font-medium text-slate-400 mb-2">文章標題 *</label>
          <input 
            type="text" 
            id="title" 
            placeholder="文章標題" 
            class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors" 
            required 
          />
        </div>
        <div>
          <label for="author_name" class="block text-sm font-medium text-slate-400 mb-2">作者名稱 *</label>
          <input 
            type="text" 
            id="author_name" 
            placeholder="作者名稱" 
            class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors" 
            required 
          />
        </div>
      </div>

      <!-- 自訂 Slug 欄位 (選填，預設依中文標題生成) -->
      <div>
        <label for="slug" class="block text-sm font-medium text-slate-400 mb-2">
          自訂網址代稱 (Slug) <span class="text-xs text-slate-500 font-normal">（選填，預設根據中文標題自動生成）</span>
        </label>
        <input 
          type="text" 
          id="slug" 
          name="slug" 
          placeholder="例如：房價數據觀察 或 custom-english-slug（留空自動依標題生成）" 
          class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors" 
        />
      </div>

      <CategorySection />

      <div>
        <!-- 摘要 (SEO 用) 文字區域 -->
        <label
          for="summary"
          class="block text-sm font-medium text-slate-400 mb-2"
          >摘要 (SEO 用)</label
        >
        <textarea
          id="summary"
          name="summary"
          rows="3"
          class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          placeholder="可留空，系統會自動從內容生成"></textarea>
      </div>

      <CoverSection />

      <div id="editorjs" class="min-h-80 border border-white/20 rounded p-4 bg-void-black"></div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <!-- 狀態選擇下拉菜單 -->
          <label
            for="status"
            class="block text-sm font-medium text-slate-400 mb-2">狀態</label
          >
          <select
            id="status"
            name="status"
            class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          >
            <option value="draft">草稿</option>
            <option value="published">發佈</option>
          </select>
        </div>
        <div>
          <!-- 發佈日期時間選擇器 -->
          <label
            for="publishedAt"
            class="block text-sm font-medium text-slate-400 mb-2"
            >發佈日期</label
          >
          <input
            type="datetime-local"
            id="publishedAt"
            name="publishedAt"
            class="w-full px-4 py-2 bg-void-black border border-white/20 rounded text-white focus:outline-none focus:border-primary transition-colors"
          />
        </div>
      </div>

      <div class="flex gap-4 pt-4 sticky bottom-0 bg-void-black pb-2">
        <button type="submit" id="submitBtn" class="bg-primary text-white px-6 py-2 rounded font-bold hover:bg-primary/80 transition-all">保存</button>
        <button type="button" id="cancelModalBtn" class="border border-white/20 text-slate-300 px-6 py-2 rounded font-bold hover:bg-white/10 transition-all">取消</button>
      </div>
    </form>
  </div>
</div>

<script>
  import { createModalHandler } from './modalLogic.ts';
  
  const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

  const elements = {
    modal: $("editModal"),
    form: $<HTMLFormElement>("postForm"),
    modalTitle: $("modalTitle"),
    submitBtn: $<HTMLButtonElement>("submitBtn"),
    coverInput: $<HTMLInputElement>("cover_upload"),
    imagePreview: $<HTMLImageElement>("image_preview"),
    previewContainer: $("preview_container"),
    categoriesContainer: $("categoriesContainer"),
    newCatInput: $<HTMLInputElement>("newCategoryInput"),
    statusSelect: ($("status") as any) as HTMLSelectElement,
    titleInput: $<HTMLInputElement>("title"),
    slugInput: $<HTMLInputElement>("slug"),
    authorInput: $<HTMLInputElement>("author_name"),
    summaryInput: $<HTMLTextAreaElement>("summary"),
    coverPreview: $<HTMLImageElement>("cover_preview"),
    publishedAtInput: $<HTMLInputElement>("publishedAt"),
    cancelBtn: $<HTMLButtonElement>("cancelModalBtn"),
    addCatBtn: $<HTMLButtonElement>("addCategoryBtn"),
  };

  const handler = createModalHandler(elements);

  window.addEventListener("open-edit-modal", (e: any) => handler.openModal(e.detail.id));
  elements.form.onsubmit = handler.handleSubmit;
  // 頂部 X 按鈕的關閉邏輯
  document.getElementById("closeModalBtn")!.onclick = handler.closeModal;

  elements.addCatBtn.addEventListener("click", handler.handleAddCategory);

  elements.publishedAtInput.addEventListener('click', () => {
    if (typeof elements.publishedAtInput.showPicker === 'function') {
      elements.publishedAtInput.showPicker();
    }
  });
</script>