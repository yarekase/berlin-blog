---
/**
 * 文章列表表格組件
 * 顯示所有文章的表格和操作按鈕
 */
import type { Post } from "../utils/postManager";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section>
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold">文章管理</h2>
    <button
      id="newPostBtn"
      class="bg-primary text-white px-6 py-2 rounded font-bold hover:bg-primary/80 transition-all"
    >
      新增文章
    </button>
  </div>

  <!-- 文章列表表格 -->
  <div class="border border-white/10 rounded-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-void-black/50 border-b border-white/10">
          <tr>
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-400"
              >標題</th
            >
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-400"
              >作者</th
            >
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-400"
              >分類</th
            >
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-400"
              >狀態</th
            >
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-400"
              >建立日期</th
            >
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-400"
              >操作</th
            >
          </tr>
        </thead>
        <tbody id="postsList">
          {
            posts.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-slate-500">
                  暫無文章
                </td>
              </tr>
            ) : (
              posts.map((post) => (
                <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                  <td class="px-6 py-4">
                    <div class="font-medium text-white">{post.title}</div>
                    <div class="text-xs text-slate-500">{post.id}</div>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-300">
                    {post.author_name}
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1">
                      {post.categories.map((cat) => (
                        <span class="text-[10px] bg-white/10 px-2 py-0.5 rounded text-slate-300">
                          {cat.name}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span
                      class={`text-xs px-2 py-1 rounded-full ${
                        post.status === "published"
                          ? "bg-green-500/10 text-green-400"
                          : "bg-yellow-500/10 text-yellow-400"
                      }`}
                    >
                      {post.status === "published" ? "已發布" : "草稿"}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-400">
                    {new Date(post.created_at).toLocaleDateString()}
                  </td>
                  <td class="px-6 py-4 text-sm">
                    <div class="flex gap-3">
                      <button
                        class="text-primary hover:text-primary/80 transition-colors edit-btn"
                        data-id={post.id}
                      >
                        編輯
                      </button>
                      <button
                        class="text-red-400 hover:text-red-300 transition-colors delete-btn"
                        data-id={post.id}
                      >
                        刪除
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
