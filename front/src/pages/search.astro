---
/// <reference types="astro/client" />
import Layout from "../layouts/Layout.astro";
import type { Post } from "../types/post";

const configuredApiURL = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8787";
const normalizedApiURL = configuredApiURL.replace(/\/$/, "");
const apiBase = normalizedApiURL.endsWith("/api")
  ? normalizedApiURL
  : `${normalizedApiURL}/api`;
const query = (Astro.url.searchParams.get("q") || "").trim();
let posts: Post[] = [];

try {
  const postsRes = await fetch(`${apiBase}/posts`);
  if (postsRes.ok) {
    const allPosts = (await postsRes.json()) as Post[];
    posts = allPosts.filter((post) => post.status === "published");
  }
} catch (error) {
  console.error("無法自 API 獲取文章列表:", error);
}

function normalize(value: string): string {
  return value.toLocaleLowerCase().replace(/\s+/g, " ").trim();
}

function getContentText(content: string): string {
  try {
    const data = JSON.parse(content) as {
      blocks?: Array<{ data?: { text?: string; items?: string[]; caption?: string } }>;
    };
    if (!Array.isArray(data.blocks)) return content.replace(/<[^>]*>/g, " ");

    return data.blocks
      .flatMap((block) => {
        const blockData = block.data || {};
        return [
          blockData.text || "",
          ...(Array.isArray(blockData.items) ? blockData.items : []),
          blockData.caption || "",
        ];
      })
      .join(" ")
      .replace(/<[^>]*>/g, " ");
  } catch {
    return content.replace(/<[^>]*>/g, " ");
  }
}

const normalizedQuery = normalize(query);
const matchedPosts = normalizedQuery
  ? posts.filter((post) => {
      const categories = (post.categories || [])
        .flatMap((category) => [category.name, category.slug])
        .join(" ");
      const searchableText = normalize(
        [post.title, categories, getContentText(post.content)].join(" "),
      );
      return searchableText.includes(normalizedQuery);
    })
  : [];
const latestPosts = posts.slice(0, 3);
---

<Layout title={query ? `搜尋「${query}」｜子迂的蠹酸齋` : "文章搜尋｜子迂的蠹酸齋"}>
  <main class="min-h-screen bg-void-black pb-24 font-display text-stucco-white">
    <div class="mx-auto max-w-300 px-4 pt-12 sm:px-6 md:pt-24">
      <header class="mb-12 border-b border-white/10 pb-8">
        <a
          href="/"
          class="mb-8 inline-flex items-center gap-2 text-sm text-slate-400 transition-colors hover:text-primary"
        >
          <span aria-hidden="true">←</span>
          返回首頁
        </a>
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-primary">
          Search
        </p>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-6xl">
          {query ? `搜尋「${query}」` : "文章搜尋"}
        </h1>
      </header>

      <section class="mb-20">
        <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4">
          <h2 class="text-2xl font-bold text-white">搜尋結果</h2>
          {normalizedQuery && (
            <span class="text-xs uppercase tracking-widest text-slate-500">
              {matchedPosts.length} 篇
            </span>
          )}
        </div>

        {normalizedQuery && matchedPosts.length > 0 ? (
          <div class="grid grid-cols-1 gap-8">
            {matchedPosts.map((post) => (
              <a
                href={`/post/${post.slug}`}
                class="group grid grid-cols-[120px_1fr] gap-5 border-b border-white/10 pb-8 sm:grid-cols-[240px_1fr] sm:gap-8"
              >
                <div class="aspect-video overflow-hidden border border-white/10 bg-[#111]">
                  {post.cover_image ? (
                    <img
                      src={post.cover_image}
                      alt={post.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center text-[10px] font-bold uppercase tracking-widest text-slate-700">
                      No Image
                    </div>
                  )}
                </div>
                <div>
                  <h3 class="text-lg font-bold leading-7 text-white transition-colors group-hover:text-primary sm:text-2xl">
                    {post.title}
                  </h3>
                  {post.summary && (
                    <p class="mt-3 line-clamp-3 text-base leading-7 text-slate-400">
                      {post.summary}
                    </p>
                  )}
                  <div class="mt-4 text-xs uppercase tracking-widest text-slate-500">
                    {new Date(post.created_at).toLocaleDateString("zh-TW")}
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="border border-dashed border-white/10 py-14 text-center text-sm text-slate-500">
            {normalizedQuery ? "找不到相關的文章" : "請輸入搜尋內容"}
          </p>
        )}
      </section>

      <section>
        <div class="mb-8 flex items-baseline justify-between border-b border-white/10 pb-4">
          <h2 class="text-2xl font-bold text-white">快來看最新的文章</h2>
          <a href="/posts" class="text-sm text-slate-400 transition-colors hover:text-primary">
            查看全部
          </a>
        </div>

        {latestPosts.length > 0 ? (
          <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
            {latestPosts.map((post) => (
              <a href={`/post/${post.slug}`} class="group">
                <div class="relative mb-6 aspect-video overflow-hidden border border-white/10 bg-[#111]">
                  {post.cover_image ? (
                    <img
                      src={post.cover_image}
                      alt={post.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-xs font-bold uppercase tracking-widest text-slate-700">
                      No Image
                    </div>
                  )}
                </div>
                <h3 class="text-lg font-bold leading-7 text-white transition-colors group-hover:text-primary md:text-xl">
                  {post.title}
                </h3>
                <div class="mt-4 text-xs uppercase tracking-widest text-slate-500">
                  {new Date(post.created_at).toLocaleDateString("zh-TW")}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="border border-dashed border-white/10 py-12 text-center text-sm text-slate-500">
            尚無文章
          </p>
        )}
      </section>
    </div>
  </main>
</Layout>
