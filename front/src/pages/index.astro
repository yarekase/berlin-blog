---
// 1. 導入佈局組件與資料管理工具
import Layout from "../layouts/Layout.astro";
import type { Post, Category, Image } from "../utils/postManager";

// 2. 環境變數處理：設定後端 Worker API 位址
const apiURL = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8787";

// 3. 資料狀態初始化
let posts: Post[] = [];
let categories: Category[] = [];

try {
  const postsRes = await fetch(`${apiURL}/posts`);
  if (postsRes.ok) {
    const allPosts = (await postsRes.json()) as Post[];
    posts = allPosts.filter((p) => p.status === "published");
  }
} catch (error) {
  console.error("無法自 API 獲取文章列表:", error);
}

try {
  const catsRes = await fetch(`${apiURL}/categories`);
  if (catsRes.ok) {
    categories = (await catsRes.json()) as Category[];
  }
} catch (error) {
  console.error("無法自 API 獲取分類列表:", error);
}

try {
  const imagesRes = await fetch(`${apiURL}/images`);
  if (imagesRes.ok) {
    const images = (await imagesRes.json()) as Image[];
    
  }
} catch (error) {
  console.error("無法自 API 獲取圖片列表:", error);
}

// 4. 頁面佈局邏輯：將文章拆分為「特色文章 (第一篇)」與「近期文章 (接下來的三篇)」
const featuredPost = posts[0];
const recentPosts = posts.slice(0, 3);
const hasAdminToken = Boolean(Astro.cookies.get("adminToken")?.value);
console.log("文章列表有", posts);
console.log("近期文章有：", recentPosts);
---

<Layout title="子迂的蠹酸齋">
  <main class="min-h-screen bg-void-black pb-24 font-display text-base text-stucco-white">
    <!-- A. 頂部搜尋區塊：提供關鍵字檢索功能 -->
    <div class="mb-8 flex w-full flex-col items-stretch justify-between gap-4 sm:flex-row sm:items-start sm:gap-6">
      <form action="/search" method="get" class="flex w-full max-w-2xl flex-col gap-3 sm:flex-row">
        <div class="relative w-full group">
          <div
            class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 text-slate-500 group-focus-within:text-primary transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>

          <input
            id="postSearchInput"
            type="text"
            name="q"
            placeholder="搜尋文章、分類或關鍵字..."
            aria-label="搜尋文章、分類或關鍵字"
            autocomplete="off"
            required
            pattern=".*\S.*"
            class="w-full bg-white/5 border border-white/10 text-slate-200 text-sm rounded-xl py-3 pl-12 pr-4 focus:outline-none focus:border-primary/50 focus:bg-white/10 focus:ring-4 focus:ring-primary/10 transition-all placeholder:text-slate-600"
          />

          <button
            type="submit"
            class="absolute inset-y-1 right-1 flex items-center gap-2 rounded-lg bg-primary px-3 text-sm font-medium text-white transition-colors hover:bg-primary/80"
          >
            <span aria-hidden="true">⌕</span>
            <span>搜尋</span>
          </button>
        </div>
      </form>

      <nav class="flex shrink-0 items-center justify-end gap-5 pt-1 sm:pt-2" aria-label="主要導覽">
        <a
          href="/posts"
          class="whitespace-nowrap text-sm font-medium text-slate-400 transition-colors hover:text-primary"
        >
          所有文章
        </a>
        {
          hasAdminToken ? (
            <button
              id="homepageLogoutBtn"
              type="button"
              class="whitespace-nowrap text-sm font-medium text-slate-400 transition-colors hover:text-primary"
            >
              登出
            </button>
          ) : (
            <a
              href="/admin/login"
              class="whitespace-nowrap text-sm font-medium text-slate-400 transition-colors hover:text-primary"
            >
              登入
            </a>
          )
        }
      </nav>
    </div>

    <!-- B. 英雄圖 (Hero Section)：視覺焦點，通常放置品牌大圖 -->
    <!-- 首頁圖區，寬滿版，高32(128px) relative子元素的基準點 border邊界線有底線 邊界線顏色白色透明 -->
    <div class="w-full h-32 relative border-b border-white/10">
      <!-- 預計要放圖 -->
      <div
        class="absolute inset-0 flex items-center justify-center bg-linear-to-t from-void-black/80 to-transparent"
      >
        <span>首頁圖</span>
      </div>
    </div>

    <!-- 內容區 最大寬度1200px 外邊界自動 x軸兩側預留6(24px) -->
    <div class="mx-auto max-w-300 px-4 sm:px-6">
      <!-- C. 作者資訊/自介區域：呈現部落格主人的身份與社交狀態 -->
      <div
        class="relative -mt-4 mb-12 flex flex-col items-start gap-5 sm:flex-row sm:items-end sm:gap-6"
      >
        <!-- 大頭照 -->
        <img
          src="/img/self.jpg"
          alt="柏林的大頭照"
          class="w-32 h-32 object-cover border-[6px] border-void-black shadow-xl shrink-0"
        />

        <!-- 部落格名稱 -->
        <div class="flex-1 overflow-hidden sm:self-end">
          <h1
            class="mb-1 overflow-hidden text-ellipsis whitespace-nowrap text-3xl font-bold tracking-tight text-white"
          >
            子迂的蠢酸齋
          </h1>

          <div class="flex items-center gap-3 text-primary text-sm">
            <span class="shrink-0 font-medium">424 followers</span>
          </div>
        </div>

        <!-- Follow 按鈕 -->
        <button
          class="rounded-full bg-[#222] px-6 py-3 text-sm font-bold text-primary transition-all hover:bg-slate-600 sm:self-end"
        >
          Follow
        </button>
      </div>

      <!-- D. 分類導航欄：橫向捲動的分類清單，方便讀者按主題篩選 -->
      <nav
        class="relative mb-16 flex w-full flex-nowrap gap-6 overflow-x-auto border-y border-white/5 py-4 no-scrollbar sm:gap-10"
      >
        {
          categories.length > 0 ? (
            categories.map((category) => (
              <a
                href={`/category/${category.slug}`}
                class="whitespace-nowrap py-1 text-sm font-medium uppercase tracking-wide text-slate-400 transition-colors hover:text-primary"
              >
                {category.name}
              </a>
            ))
          ) : (
            <span class="text-sm text-slate-600 italic">尚未設定分類</span>
          )
        }
      </nav>

      <!-- E. 特色文章區：顯示最新或權重最高的一篇文章，版面較大 -->
      <section class="mb-24 min-h-100">
        {
          featuredPost ? (
            <a
              href={`/post/${featuredPost.slug}`}
              class="group grid cursor-pointer grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12"
            >
              <div class="aspect-16/10 bg-[#151515] border border-white/10 overflow-hidden relative">
                {featuredPost.cover_image ? (
                  <img
                    src={featuredPost.cover_image}
                    alt={featuredPost.title}
                    class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-slate-700">
                    No Image
                  </div>
                )}
              </div>

              <div class="flex flex-col gap-4">
                <h2 class="text-3xl font-bold leading-tight text-white transition-colors group-hover:text-primary md:text-4xl">
                  {featuredPost.title}
                </h2>

                <p class="text-base leading-8 text-slate-400 line-clamp-3 md:text-lg">
                  {featuredPost.summary}
                </p>

                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500">
                  <span>{featuredPost.author_name}</span>
                  <span class="text-primary">·</span>
                  <span>
                    {new Date(featuredPost.created_at).toLocaleDateString(
                      "zh-TW",
                    )}
                  </span>
                </div>
              </div>
            </a>
          ) : (
            <div class="w-full h-100 flex items-center justify-center border border-dashed border-white/10 rounded-lg">
              <p class="text-slate-500 font-display tracking-widest uppercase">
                尚無特色文章
              </p>
            </div>
          )
        }
      </section>

      <!-- F. 近期文章網格：以 3 欄位 (桌面端) 顯示接下來的文章清單 -->
      <section class="grid min-h-75 grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
        {
          recentPosts.length > 0 ? (
            recentPosts.map((post) => (
              <a href={`/post/${post.slug}`} class="group cursor-pointer">
                <div class="aspect-video bg-[#111] border border-white/10 mb-6 relative overflow-hidden">
                  {post.cover_image ? (
                    <img
                      src={post.cover_image}
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-slate-800 font-bold text-xs uppercase tracking-widest opacity-30">
                      No Image
                    </div>
                  )}
                </div>

                <h4 class="text-lg font-bold leading-7 text-white transition-colors group-hover:text-primary line-clamp-2 md:text-xl">
                  {post.title}
                </h4>

                <div class="mt-4 text-xs uppercase tracking-widest text-slate-500">
                  {new Date(post.created_at).toLocaleDateString("zh-TW")}
                </div>
              </a>
            ))
          ) : (
            <div class="col-span-full flex items-center justify-center py-20 border border-dashed border-white/10 rounded-lg">
              <p class="text-slate-500 font-display tracking-widest uppercase">
                尚無文章
              </p>
            </div>
          )
        }
      </section>
    </div>
  </main>
</Layout>

{hasAdminToken && (
  <script>
    const homepageLogoutButton = document.querySelector("#homepageLogoutBtn");

    homepageLogoutButton?.addEventListener("click", () => {
      document.cookie = "adminToken=; path=/; max-age=0; SameSite=Strict";
      localStorage.removeItem("adminToken");
      localStorage.removeItem("adminNickname");
      window.location.reload();
    });
  </script>
)}

<style>
  /* 輔助樣式：自定義空心文字效果 */
  .text-outline {
    -webkit-text-stroke: 1px rgba(241, 245, 249, 0.5);
    color: transparent;
  }
</style>
