---
/**
 * 後台儀表板主頁面
 * 這是經過重構的主頁面，使用了模塊化組件
 */
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Statistics from "../../components/Statistics.astro";
import PostsList from "../../components/PostsList.astro";
import EditModal from "../../components/EditModal/EditModal.astro";
import SettingsModal from "../../components/SettingsModal.astro";
import "../../styles/editor.css";
import type { Post } from "../../utils/postManager";


// 從 cookies 中獲取 adminToken，若不存在則重定向到登入頁面
const token = Astro.cookies.get("adminToken")?.value;

if (!token) {
  return Astro.redirect("/admin/login");
}

// 伺服器端抓取資料
const apiURL = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8787/api/";
let posts: Post[] = [];

try {
  const postsRes = await fetch(`${apiURL}/posts`, {
    headers: {
      "Authorization": `Bearer ${token}`
    }
  });
  if (postsRes.ok) {
    posts = (await postsRes.json()) as Post[];
    console.log("伺服器端獲取文章成功，篇數:", posts.length);
  } else {
    console.error("伺服器端獲取文章失敗，API 狀態碼:", postsRes.status);
  }
} catch (error) {
  console.error("伺服器端獲取文章失敗:", error);
}

const totalCount = posts.length;
const publishedCount = posts.filter(post => post.status === 'published').length;
const draftCount = posts.filter(post => post.status === 'draft').length;
---

<Layout title="後台儀表板 - 子迂的蠹酸齋">
  <main class="min-h-screen bg-void-black text-stucco-white font-display pb-24">
    <!-- 導航欄 -->
    <Navigation />

    <!-- 主要內容 -->
    <div class="max-w-350 mx-auto px-6 py-8">
      <!-- 儀表板統計 -->
      <Statistics 
      totalCount={totalCount}
      publishedCount={publishedCount}
      draftCount={draftCount} />

      <!-- 文章管理區 -->
      <PostsList posts={posts} />
    </div>
  </main>

  <!-- 編輯模態框 -->
  <EditModal />

  <!-- 設定模態框 -->
  <SettingsModal />
</Layout>

<script>
  // 將邏輯抽離到外部檔案，保持 Astro 檔案簡潔
  import { initDashboard } from "../../scripts/adminDashboard";
  
  initDashboard();
  
</script>
