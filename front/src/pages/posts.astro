---
import Layout from "../layouts/Layout.astro";
import type { Post } from "../types/post";

const apiURL = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8787";
const pageSize = 10;
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") || "1", 10);
let posts: Post[] = [];

try {
  const postsRes = await fetch(`${apiURL}/posts`);
  if (postsRes.ok) {
    const allPosts = (await postsRes.json()) as Post[];
    posts = allPosts.filter((post) => post.status === "published");
  }
} catch (error) {
  console.error("無法自 API 獲取文章列表:", error);
}

const totalPages = Math.ceil(posts.length / pageSize);
const currentPage = Math.min(
  Math.max(Number.isNaN(requestedPage) ? 1 : requestedPage, 1),
  Math.max(totalPages, 1),
);
const visiblePosts = posts.slice(
  (currentPage - 1) * pageSize,
  currentPage * pageSize,
);
---

<Layout title="所有文章｜子迂的蠹酸齋">
  <main class="min-h-screen bg-void-black pb-24 font-display text-stucco-white">
    <div class="mx-auto max-w-300 px-4 pt-12 sm:px-6 md:pt-24">
      <div class="mb-12 flex items-end justify-between gap-6 border-b border-white/10 pb-8">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-primary">
            Archive
          </p>
          <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-6xl">
            所有文章
          </h1>
        </div>
        <a
          href="/"
          class="hidden rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:border-primary/50 hover:text-primary sm:inline-flex"
        >
          回到首頁
        </a>
      </div>

      {
        posts.length > 0 ? (
          <>
            <section class="space-y-8">
              {visiblePosts.map((post) => (
                <a
                  href={`/post/${post.slug}`}
                  class="group grid grid-cols-1 gap-6 border-b border-white/10 pb-8 md:grid-cols-[minmax(220px,0.8fr)_1.2fr] md:gap-10"
                >
                  <div class="relative aspect-video overflow-hidden border border-white/10 bg-[#111] md:aspect-16/10">
                  {post.cover_image ? (
                    <img
                      src={post.cover_image}
                      alt={post.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-xs font-bold uppercase tracking-widest text-slate-700">
                      No Image
                    </div>
                  )}
                  </div>

                  <div class="flex flex-col">
                    <h2 class="text-xl font-bold leading-8 text-white transition-colors group-hover:text-primary sm:text-2xl md:text-3xl">
                      {post.title}
                    </h2>
                    {post.summary && (
                      <p class="mt-4 line-clamp-4 text-base leading-8 text-slate-400">
                        {post.summary}
                      </p>
                    )}
                    <div class="mt-auto flex items-center gap-2 pt-5 text-xs font-bold uppercase tracking-widest text-slate-500">
                      <span>{new Date(post.created_at).toLocaleDateString("zh-TW")}</span>
                      {post.categories[0] && (
                        <>
                          <span class="text-primary">·</span>
                          <span>{post.categories[0].name}</span>
                        </>
                      )}
                    </div>
                  </div>
                </a>
              ))}
            </section>

            <nav
              aria-label="文章分頁"
              class="mt-12 flex items-center justify-center gap-2 border-t border-white/10 pt-8"
            >
              <a
                href={currentPage > 1 ? `/posts?page=${currentPage - 1}` : undefined}
                aria-label="上一頁"
                aria-disabled={currentPage === 1}
                class:list={[
                  "flex h-11 w-11 items-center justify-center rounded-lg border border-white/10 text-lg transition-colors",
                  currentPage === 1
                    ? "pointer-events-none text-slate-700"
                    : "text-slate-300 hover:border-primary/50 hover:text-primary",
                ]}
              >
                <span aria-hidden="true">←</span>
              </a>

              <div class="flex items-center gap-1">
                {Array.from({ length: totalPages }, (_, index) => index + 1).map(
                  (page) => (
                    <a
                      href={`/posts?page=${page}`}
                      aria-current={page === currentPage ? "page" : undefined}
                      class:list={[
                        "flex h-11 min-w-11 items-center justify-center rounded-lg px-2 text-sm transition-colors",
                        page === currentPage
                          ? "bg-primary font-bold text-white"
                          : "text-slate-400 hover:text-primary",
                      ]}
                    >
                      {page}
                    </a>
                  ),
                )}
              </div>

              <a
                href={currentPage < totalPages ? `/posts?page=${currentPage + 1}` : undefined}
                aria-label="下一頁"
                aria-disabled={currentPage === totalPages}
                class:list={[
                  "flex h-11 w-11 items-center justify-center rounded-lg border border-white/10 text-lg transition-colors",
                  currentPage === totalPages
                    ? "pointer-events-none text-slate-700"
                    : "text-slate-300 hover:border-primary/50 hover:text-primary",
                ]}
              >
                <span aria-hidden="true">→</span>
              </a>
            </nav>
          </>
        ) : (
          <div class="flex min-h-64 items-center justify-center border border-dashed border-white/10">
            <p class="text-sm tracking-widest text-slate-500">尚無已發布文章</p>
          </div>
        )
      }
    </div>
  </main>
</Layout>